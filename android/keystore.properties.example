## Copy this file to keystore.properties (same directory) and fill in the
## real values. keystore.properties is gitignored — never commit real
## credentials. build.gradle reads from it and falls back to unsigned
## debug builds if it's missing.
storeFile=C:/IslamTimeRelease/islamtime-release.keystore
storePassword=CHANGE_ME
keyAlias=islamtime
keyPassword=CHANGE_ME
